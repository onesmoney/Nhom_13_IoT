# Dùng chung Firebase với firmware (src/main.cpp)
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=

# Cổng chạy server
PORT=4000
# Để trống thì chỉ xem debug từ máy này. Nếu đặt token, mọi yêu cầu cần Authorization: Bearer <DEBUG_API_TOKEN>.
# Dùng chuỗi ngẫu nhiên dài, không dùng token Firebase hay đưa lên frontend/URL.
DEBUG_API_TOKEN=
# Giữ lịch sử 1 ngày để lọc theo ngày
HISTORY_HOURS=24

# File cache nằm trong thư mục server; đặt off để không lưu xuống ổ đĩa
CACHE_FILE=.cache/sensor-cache.json
HISTORY_CACHE_CLOSED_TTL_SECONDS=86400
HISTORY_CACHE_CURRENT_TTL_SECONDS=30
HISTORY_CACHE_MAX_ENTRIES=32
HISTORY_CACHE_MAX_BYTES=33554432

# Server luôn tự gộp dữ liệu thành trung vị mỗi 5 phút và XÓA dữ liệu gốc đã gộp. Nhớ sao lưu Firebase trước khi chạy.
# Chỉ cấp quyền ghi/xóa cần thiết cho tiến trình gộp, không mở quyền ghi công khai.
# Kết quả lưu ở sensorData5m; FIREBASE_DATA_PATH không được trùng hoặc lồng với đường dẫn này.
# Giữ dữ liệu gốc ít nhất 1 ngày; số ngày phải lớn hơn 0, có thể dùng số lẻ.
COMPACTION_RETAIN_DAYS=1
COMPACTION_INTERVAL_SECONDS=60
COMPACTION_PAGE_SIZE=1000
# Nhóm quá lớn thì giữ nguyên, không gộp
COMPACTION_MAX_ROWS=10000
COMPACTION_MAX_BYTES=8388608
COMPACTION_WINDOWS_PER_TICK=8
